{
  "openapi": "3.0.0",
  "info": {
    "title": "JobApply Backend API",
    "version": "1.0.0",
    "description": "API for parsing resumes and job descriptions, drafting application emails, authorizing Gmail, and sending applications."
  },
  "servers": [
    {
      "url": "http://localhost:5005",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Authentication" },
    { "name": "Resumes" },
    { "name": "Jobs" },
    { "name": "Applications" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": { "status": "ok", "service": "jobapply-api" }
              }
            }
          }
        }
      }
    },
    "/api/auth/google/url": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Create a Google OAuth consent URL",
        "description": "Requests Gmail send access and offline access. Direct the user to the returned URL.",
        "responses": {
          "200": {
            "description": "OAuth consent URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {
                    "url": { "type": "string", "format": "uri" },
                    "mock": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Handle the Google OAuth callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Authorization code supplied by Google."
          }
        ],
        "responses": {
          "302": { "description": "Redirects to the configured frontend with google_connected=true." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/resume/parse": {
      "post": {
        "tags": ["Resumes"],
        "summary": "Parse a PDF or DOCX resume",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["resume"],
                "properties": {
                  "resume": { "type": "string", "format": "binary", "description": "PDF or DOCX file, maximum 10 MB." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured candidate profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ParsedResume" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "description": "Resume exceeds 10 MB." },
          "415": { "description": "Only PDF and DOCX resumes are supported." },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/jobs/parse": {
      "post": {
        "tags": ["Jobs"],
        "summary": "Extract structured job details from raw text",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rawText"],
                "properties": { "rawText": { "type": "string", "minLength": 1 } }
              },
              "example": { "rawText": "Backend Engineer at Example Co, Lagos. Send applications to hiring@example.com. Requirements: Node.js, PostgreSQL, REST APIs." }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured job details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobDetails" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/applications/draft": {
      "post": {
        "tags": ["Applications"],
        "summary": "Draft a tailored application email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DraftRequest" },
              "example": {
                "profile": {
                  "name": "Boluwatife Oladele",
                  "title": "Backend Developer",
                  "skills": ["Node.js", "Express.js", "PostgreSQL"],
                  "summary": "Backend developer with experience building API integrations.",
                  "email": "candidate@example.com",
                  "phone": "+234 800 000 0000"
                },
                "jobDetails": {
                  "jobTitle": "Backend Engineer",
                  "companyOrIndustry": "Example Co",
                  "keyRequirements": ["Node.js", "PostgreSQL"],
                  "recipientEmail": "hiring@example.com"
                },
                "customTone": "professional and concise"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated application email. isFallback is true when Gemini rate limits are handled with a template.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationDraft" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/applications/send": {
      "post": {
        "tags": ["Applications"],
        "summary": "Send an application email with a PDF resume attached",
        "description": "Uses a provided base64 PDF or the most recent PDF uploaded to /api/resume/parse. Gmail OAuth must be connected first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendApplicationRequest" },
              "example": {
                "to": "hiring@example.com",
                "subject": "Application for Backend Engineer - Boluwatife Oladele",
                "body": "Dear Hiring Manager,\n\nPlease find my resume attached.",
                "pdfBase64": "JVBERi0xLjQKJcTl8uXrp..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendApplicationResponse" },
                "example": { "success": true, "messageId": "18d4ab12cd345678" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/apply": {
      "post": {
        "tags": ["Applications"],
        "summary": "Generate a cover letter and start the legacy application pipeline",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplyRequest" },
              "example": {
                "jobUrl": "https://example.com/jobs/backend-engineer",
                "jobDescription": "Seeking a Node.js backend engineer.",
                "candidateProfile": { "name": "Boluwatife Oladele", "skills": ["Node.js", "Express.js"] },
                "applyTarget": "Auto-Detect"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cover letter and browser-automation result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "service"],
        "properties": { "status": { "type": "string", "example": "ok" }, "service": { "type": "string", "example": "jobapply-api" } }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string", "example": "Provide a non-empty rawText value." } }
      },
      "ParsedResume": {
        "type": "object",
        "required": ["fileName", "parsedAt", "summary", "yearsOfExperience"],
        "properties": {
          "fileName": { "type": "string", "example": "Boluwatife_Oladele_Resume.pdf" },
          "parsedAt": { "type": "string", "format": "date-time" },
          "name": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true, "format": "email" },
          "phone": { "type": "string", "nullable": true },
          "title": { "type": "string", "nullable": true },
          "skills": { "type": "array", "nullable": true, "items": { "type": "string" } },
          "summary": { "type": "string" },
          "yearsOfExperience": { "type": "string", "example": "2+ Years" }
        }
      },
      "JobDetails": {
        "type": "object",
        "required": ["jobTitle", "companyOrIndustry", "recipientEmail", "location", "remuneration", "employmentType", "keyRequirements"],
        "properties": {
          "jobTitle": { "type": "string", "nullable": true, "example": "Backend Engineer" },
          "companyOrIndustry": { "type": "string", "nullable": true, "example": "Example Co" },
          "recipientEmail": { "type": "string", "nullable": true, "format": "email", "example": "hiring@example.com" },
          "location": { "type": "string", "nullable": true, "example": "Lagos, Nigeria" },
          "remuneration": { "type": "string", "nullable": true },
          "employmentType": { "type": "string", "nullable": true, "example": "Full-time" },
          "keyRequirements": { "type": "array", "items": { "type": "string" }, "example": ["Node.js", "PostgreSQL", "REST APIs"] }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" }
        }
      },
      "DraftRequest": {
        "type": "object",
        "required": ["profile", "jobDetails"],
        "properties": {
          "profile": { "$ref": "#/components/schemas/Profile" },
          "jobDetails": { "$ref": "#/components/schemas/JobDetails" },
          "customTone": { "type": "string", "example": "professional and concise" }
        }
      },
      "ApplicationDraft": {
        "type": "object",
        "required": ["subject", "body", "recipientEmail"],
        "properties": {
          "subject": { "type": "string", "example": "Application for Backend Engineer - Boluwatife Oladele" },
          "body": { "type": "string", "example": "Dear Hiring Manager,\n\nI am writing to express my interest in the role." },
          "recipientEmail": { "type": "string", "nullable": true, "format": "email" },
          "isFallback": { "type": "boolean", "description": "Present and true when a rate-limit fallback was used." }
        }
      },
      "SendApplicationRequest": {
        "type": "object",
        "required": ["to", "subject", "body"],
        "properties": {
          "to": { "type": "string", "format": "email" },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "pdfBase64": { "type": "string", "description": "Optional base64 PDF. The last uploaded PDF is used when omitted." }
        }
      },
      "SendApplicationResponse": {
        "type": "object",
        "required": ["success", "messageId"],
        "properties": { "success": { "type": "boolean", "example": true }, "messageId": { "type": "string" } }
      },
      "ApplyRequest": {
        "type": "object",
        "required": ["candidateProfile"],
        "properties": {
          "jobUrl": { "type": "string", "format": "uri" },
          "jobDescription": { "type": "string" },
          "candidateProfile": { "$ref": "#/components/schemas/Profile" },
          "applyTarget": { "type": "string", "default": "Auto-Detect" }
        },
        "anyOf": [{ "required": ["jobUrl"] }, { "required": ["jobDescription"] }]
      },
      "ApplyResponse": {
        "type": "object",
        "required": ["coverLetter", "automation"],
        "properties": { "coverLetter": { "type": "string" }, "automation": { "type": "object", "additionalProperties": true } }
      }
    },
    "responses": {
      "BadRequest": { "description": "The request is missing or contains invalid input.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ServiceUnavailable": { "description": "A required external service is not configured or unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InternalError": { "description": "The server could not complete the request.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}